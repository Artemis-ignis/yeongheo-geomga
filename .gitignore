# Local asset intake, archive, and resumable img2threejs state are not runtime
# deliverables. Keep them on the workstation for audit/recovery without
# allowing unapproved candidates to enter the repository or shipped bundle.
/.img2threejs/
/artifacts/asset-intake/
/artifacts/asset-archive/
/artifacts/img2threejs/jade-sanctuary-gate/

# Keep the v3 reference brief and admitted outputs reviewable, but do not
# accumulate generated crops or failed probe copies in the repository.
