  "artifactSchema": {
    "requiredFields": ["screenshot", "console", "page", "layout", "luma"],
    "statuses": ["NOT_CAPTURED", "CAPTURED"],
    "screenshot": {
      "requiredFields": ["status", "path", "sha256", "bytes", "width", "height"]
    },
    "console": {
      "requiredFields": ["status", "errors", "warnings", "pageErrors"]
    },
    "page": {
      "requiredFields": ["status", "state", "runTimeSeconds", "expectedState", "result"]
    },
    "layout": {
      "requiredFields": [
        "status",
        "viewport",
        "canvasCss",
        "canvasBacking",
        "overflow",
        "rects",
        "overlaps"
      ]
    },
    "luma": {
      "requiredFields": [
        "status",
        "mean",
        "p01",
        "p99",
        "blackFraction",
        "flat"
      ]
    }
  },
  "hardGates": {
    "runIdentity": "releaseId, build hashes, package hash, seed, viewport and runId must be present and immutable",
    "runtimeEvidence": "every canonical state must have CAPTURED screenshot, console, page, layout and luma artifacts before a runtime verdict",
    "consoleErrors": 0,
    "consoleWarnings": 0,
    "pageErrors": 0,
    "overflowX": 0,
    "overflowY": 0,
    "criticalOverlap": 0,
    "screenshotDimensions": "screenshot dimensions must equal the declared viewport",
    "luma": "flat must be false and blackFraction must be below 0.98",
    "actualInput": "showcase run must use actual WASD, Space and card clicks; no bypass, time skip or forced boss",
    "browserBoundary": "this contract runner never launches a browser; runtime evidence is supplied by the release owner"
  },
  "critic": {
    "scoreRange": [0, 1],
    "globalThreshold": 0.7,
    "criticalFeatureThreshold": 0.7,
    "layers": [
      "silhouetteGrounding",
      "worldDepthSurface",
      "combatReadability",
      "hudModalHierarchy",
      "stateTransition",
      "performanceStability",
      "avIntegrity"
    ],
    "severity": ["P0", "P1", "P2"],
    "freshReviewRequired": true,
    "numericDiffCannotApprove": true,
    "humanOriginalSizeApprovalExternal": true
  },
  "retention": {
    "runRoot": "output/qa/runs",
    "successfulRunsToKeep": 2,
    "failedRunRetentionDays": 7,
    "rawMedia": "temporary-only-unless-cited-by-report",
    "deduplicateBy": "sha256",
    "protectedRoots": ["output/releases"],
    "pruneMode": "dry-run-by-default"
  }
}
